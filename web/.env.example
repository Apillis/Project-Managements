# Supabase API URL (desktop: http://127.0.0.1:54321, server: https://pm.apillis.lan)
VITE_SUPABASE_URL=http://127.0.0.1:54321
# "anon" public key printed by `supabase start` / in the server .env (ANON_KEY)
VITE_SUPABASE_ANON_KEY=replace-me
# Show the "Sign in with Google" button (requires Google OAuth configured in Supabase)
VITE_ENABLE_GOOGLE=false
