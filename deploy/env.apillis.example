# ---- Append these lines to /opt/apillis-pm/supabase/.env ---------------------
# Host names (add them to the LAN DNS / router, pointing to the server IP)
PM_DOMAIN=pm.apillis.lan
STUDIO_DOMAIN=studio.apillis.lan
ADMIN_IP=192.168.1.20

# Public URL of the system (also set SITE_URL, API_EXTERNAL_URL, SUPABASE_PUBLIC_URL to it)
# SUPABASE_PUBLIC_URL=https://pm.apillis.lan

# Notifier SMTP (e.g. Google Workspace: smtp.gmail.com / 587 / app password)
PM_SMTP_HOST=
PM_SMTP_PORT=587
PM_SMTP_SECURE=false
PM_SMTP_USER=
PM_SMTP_PASS=
PM_SMTP_FROM="Apillis PM <pm@apillis.com>"

# Backups
BACKUP_DIR=/opt/apillis-pm/backups
NAS_TARGET=                 # e.g. backup@192.168.1.10:/volume1/backup/apillis-pm
RCLONE_REMOTE=              # e.g. gdrive-crypt:apillis-pm  (encrypted rclone remote)
